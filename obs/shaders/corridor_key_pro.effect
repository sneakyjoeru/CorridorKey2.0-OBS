// CorridorKey Pro keyer - real-time GPU chroma key for OBS Studio
// For use with the obs-shaderfilter plugin ("User-defined shader" filter).
// https://obsproject.com/forum/resources/obs-shaderfilter.1736/
// v.01 2026-10-21 sneakyjoeru - based on CorridorKey despill math
// (corridorkey/runtime.py:_despill_average_srgb_torch) and the OBS built-in
// chroma_key_filter.effect (CC BY-NC-SA, Corridor Digital LLC / OBS project).
//
// Runs entirely on the GPU in one pixel pass: ~10 texture taps + math per pixel.
// Improvements over OBS's built-in Chroma Key filter:
//   * Brightness-invariant normalized-RGB distance instead of YUV yz-plane -> even keying
//     across shadows and highlights on the same screen hue.
//   * Lightness term with low weight so dark green-screen folds still key.
//   * 9-tap box-filtered distance (denoises webcam grain before it keys).
//   * CorridorKey's own despill formula (spill redistributed into r/b), gated
//     to edge pixels only, so green clothing inside the subject is untouched.
//   * Separate smoothness for matte vs despill ramp (two knobs, cleaner edges).

uniform float4x4 ViewProj;
uniform texture2d image;

uniform float2 uv_pixel_interval;

// ---- user controls (obs-shaderfilter exposes these as sliders) ------------
uniform float4 key_color = float4(0.0, 0.8, 0.0, 1.0); // screen color, pick from your shot
uniform int   key_axis = 0;        // 0 = green screen, 1 = blue screen, 2 = red screen
uniform float similarity = 0.35;   // key radius, normalized-RGB units (~0..1.2)
uniform float smoothness = 0.10;   // soft matte width above similarity
uniform float despill_strength = 0.6; // 0 = off, 1 = full CorridorKey despill
uniform float denoise = 1.0;       // 0 = center tap only, 1 = full 9-tap box filter

sampler_state textureSampler {
	Filter    = Linear;
	AddressU  = Clamp;
	AddressV  = Clamp;
	BorderColor = 00000000;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
	VertData vert_out;
	vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = v_in.uv;
	return vert_out;
}

// ---- color helpers ---------------------------------------------------------
// sRGB display-coded -> approximate linear (branchless, cheap).
float3 toLinear(float3 c)
{
	return pow(max(c, 0.0), float3(2.4, 2.4, 2.4));
}

// Brightness-invariant keying metric: normalize linear RGB to unit sum, so a
// dark screen fold and a bright screen spot sit the same distance from the key
// as their pure hue (ImageMatte-style similarity keying).
float3 normRGB(float3 lin)
{
	 float s = max(lin.r + lin.g + lin.b, 1e-4);
	 return lin / s;
}

float4 SampleTexture(float2 uv)
{
	return image.Sample(textureSampler, uv);
}

// Distance in normalized-linear-RGB space (range ~0..1.22): hue/saturation
// only, brightness-invariant, so screen folds key at any exposure and gray/
// white/black subject pixels never key out.
float KeyDist(float3 srgb, float3 keynrm)
{
	 float3 n = normRGB(toLinear(srgb));
	 float dr = n.x - keynrm.x;
	 float dg = n.y - keynrm.y;
	 float db = n.z - keynrm.z;
	 return sqrt(dr * dr + dg * dg + db * db);
}

// 9-tap box-filtered distance (same topology as OBS built-in), blended with
// the center tap by `denoise` so you can dial it off for sharp sources.
float FilteredKeyDist(float3 rgb, float2 uv, float3 keynrm)
{
	// uv_pixel_interval is the per-pixel step in UV units (plugin-provided).
	float2 h = uv_pixel_interval;
	float d = KeyDist(SampleTexture(uv - float2(h.x * 2.0, h.y)).rgb, keynrm);
	d += KeyDist(SampleTexture(uv + float2(h.x * 2.0, h.y)).rgb, keynrm);
	d += KeyDist(SampleTexture(uv + float2(h.x, -h.y * 2.0)).rgb, keynrm);
	d += KeyDist(SampleTexture(uv + float2(-h.x, h.y * 2.0)).rgb, keynrm);
	d *= 2.0;
	d += KeyDist(rgb, keynrm);
	d /= 9.0;
	return lerp(KeyDist(rgb, keynrm), d, saturate(denoise));
}

// ---- CorridorKey despill, generalized to the chosen screen axis ------------
// Green port of corridorkey/runtime.py:_despill_average_srgb_torch:
//   spill = max(g - (r+b)*0.5, 0); r += spill*0.5; g -= spill; b += spill*0.5
float3 Despill(float3 c)
{
	if (key_axis == 0) { // green
		float spill = max(c.g - (c.r + c.b) * 0.5, 0.0);
		return float3(c.r + spill * 0.5, c.g - spill, c.b + spill * 0.5);
	} else if (key_axis == 1) { // blue
		float spill = max(c.b - (c.r + c.g) * 0.5, 0.0);
		return float3(c.r + spill * 0.5, c.g + spill * 0.5, c.b - spill);
	} else { // red
		float spill = max(c.r - (c.g + c.b) * 0.5, 0.0);
		return float3(c.r - spill, c.g + spill * 0.5, c.b + spill * 0.5);
	 }
}

float4 PSChromaKeyPro(VertData v_in) : TARGET
{
	float4 rgba = SampleTexture(v_in.uv);

	// Key color's normalized-linear target, computed once per pixel.
	// key_color is display-coded sRGB like the source texture.
	// (key_color.a is unused.)
	float3 keynrm = normRGB(toLinear(key_color.rgb));

	float dist = FilteredKeyDist(rgba.rgb, v_in.uv, keynrm);
	float base = dist - similarity;
	float mask = pow(saturate(base / max(smoothness, 1e-4)), 1.5);

	// Despill only near the key edge (where mask < 1): interior subject pixels
	// keep their real colors, so green clothing survives.
	float3 desp = Despill(rgba.rgb);
	float spillAmt = saturate(despill_strength) * (1.0 - mask);
	rgba.rgb = lerp(rgba.rgb, desp, spillAmt);

	rgba.a *= mask;
	return rgba;
}

technique Draw
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSChromaKeyPro(v_in);
	}
}
