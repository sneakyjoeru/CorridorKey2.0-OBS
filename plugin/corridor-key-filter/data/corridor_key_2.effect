// Corridor Key 2.0 - GPU keyer effect for the native OBS plugin.
// Keying math: brightness-invariant normalized-RGB distance + CorridorKey
// despill (corridorkey/runtime.py:_despill_average_srgb_torch). CC BY-NC-SA.
uniform float4x4 ViewProj;
uniform texture2d image;

uniform float2 uv_pixel_interval;
// Brace initializer: OBS < 32.2 effect parser rejects float4(...) here.
uniform float4 key_color = {0.0, 1.0, 0.0, 1.0};
uniform float similarity = 0.35;
uniform float smoothness = 0.10;
uniform float despill_strength = 0.6;
uniform float denoise = 1.0;

// Static background removal: one frame of the empty background, captured by
// the C side, plus this frame copied through the same pass, so both textures
// hold identically stored pixels and nothing depends on backend colour
// handling.
uniform texture2d plate_image;
uniform texture2d frame_image;
uniform float plate_tolerance = 0.06;
uniform float plate_softness = 0.06;

// Moving subject mode: state_image.rgb is the adaptively learned background
// (the C side ping-pongs it between two render targets). Nothing here assumes
// how the backend stores render targets: every texture involved comes out of
// the same copy pass.
uniform texture2d state_image;
uniform float motion_sensitivity = 0.06;
uniform float motion_hold = 10.0;
uniform float motion_learn = 0.02;

sampler_state textureSampler {
	Filter    = Linear;
	AddressU  = Clamp;
	AddressV  = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
	VertData vert_out;
	vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = v_in.uv;
	return vert_out;
}

float3 toLinear(float3 c)
{
	return pow(max(c, 0.0), float3(2.4, 2.4, 2.4));
}

float3 normRGB(float3 lin)
{
	 float s = max(lin.r + lin.g + lin.b, 1e-4);
	 return lin / s;
}

// Distance in normalized-linear-RGB space (~0..1.22): hue/saturation only,
// brightness-invariant - screen folds key at any exposure, grays never key.
float KeyDist(float3 srgb, float3 keynrm)
{
	 float3 n = normRGB(toLinear(srgb));
	 float dr = n.x - keynrm.x;
	 float dg = n.y - keynrm.y;
	 float db = n.z - keynrm.z;
	 return sqrt(dr * dr + dg * dg + db * db);
}

float FilteredKeyDist(float3 rgb, float2 uv, float3 keynrm)
{
	 float2 h = uv_pixel_interval;
	 float d = KeyDist(image.Sample(textureSampler, uv - float2(h.x * 2.0, h.y)).rgb, keynrm);
	 d += KeyDist(image.Sample(textureSampler, uv + float2(h.x * 2.0, h.y)).rgb, keynrm);
	 d += KeyDist(image.Sample(textureSampler, uv + float2(h.x, -h.y * 2.0)).rgb, keynrm);
	 d += KeyDist(image.Sample(textureSampler, uv + float2(-h.x, h.y * 2.0)).rgb, keynrm);
	 d *= 2.0;
	 d += KeyDist(rgb, keynrm);
	 d /= 9.0;
	 return lerp(KeyDist(rgb, keynrm), d, saturate(denoise));
}

// --- Static background removal ("plate") --------------------------------
// The C side captures one frame of the empty background into plate_image;
// every pixel within plate_tolerance of that stored frame is keyed out. The
// difference is measured in the encoded (sRGB) space OBS hands us, so the
// tolerance behaves the same in shadows and in highlights.
float PlateDiff(float3 a, float3 b)
{
	return dot(abs(a - b), float3(0.299, 0.587, 0.114));
}

float PlateDiffAt(float2 uv)
{
	return PlateDiff(frame_image.Sample(textureSampler, uv).rgb,
	                 plate_image.Sample(textureSampler, uv).rgb);
}

// Same 9-tap neighbourhood as FilteredKeyDist, applied to the plate difference
// so sensor noise does not punch holes into the removed background.
float FilteredPlateDiff(float2 uv)
{
	 float2 h = uv_pixel_interval;
	 float d = PlateDiffAt(uv - float2(h.x * 2.0, h.y));
	 d += PlateDiffAt(uv + float2(h.x * 2.0, h.y));
	 d += PlateDiffAt(uv + float2(h.x, -h.y * 2.0));
	 d += PlateDiffAt(uv + float2(-h.x, h.y * 2.0));
	 d *= 2.0;
	 d += PlateDiffAt(uv);
	 d /= 9.0;
	 return lerp(PlateDiffAt(uv), d, saturate(denoise));
}

// CorridorKey despill, generalized to the dominant channel of key_color.
float3 Despill(float3 c)
{
	if (key_color.g >= key_color.r && key_color.g >= key_color.b) { // green
		float spill = max(c.g - (c.r + c.b) * 0.5, 0.0);
		return float3(c.r + spill * 0.5, c.g - spill, c.b + spill * 0.5);
	} else if (key_color.b >= key_color.r) { // blue
		float spill = max(c.b - (c.r + c.g) * 0.5, 0.0);
		return float3(c.r + spill * 0.5, c.g + spill * 0.5, c.b - spill);
	} else { // red
	 float spill = max(c.r - (c.g + c.b) * 0.5, 0.0);
	 return float3(c.r - spill, c.g + spill * 0.5, c.b + spill * 0.5);
 }
}

float4 PSChromaKeyPro(VertData v_in) : TARGET
{
	float4 rgba = image.Sample(textureSampler, v_in.uv);
	// OBS textures are premultiplied: key on straight color (as the
	// built-in chroma_key_filter_v2.effect does), premultiply the result.
	rgba.rgb *= (rgba.a > 0.) ? (1. / rgba.a) : 0.;

	 float3 keynrm = normRGB(toLinear(key_color.rgb));

	 float dist = FilteredKeyDist(rgba.rgb, v_in.uv, keynrm);
	 float base = dist - similarity;
	 float mask = pow(saturate(base / max(smoothness, 1e-4)), 1.5);

	 // Despill the whole foreground, like CorridorKey's reference
	 // (_despill_average_srgb_torch: fg*(1-s) + despilled*s). Gating it by
	 // (1 - mask) limited it to the 1-2 px alpha ramp, so the slider had no
	 // visible effect on opaque subject pixels. Despill only touches pixels
	 // whose key channel exceeds the mean of the other two, so skin and grays
	 // are unchanged.
	 float3 desp = Despill(rgba.rgb);
	 rgba.rgb = lerp(rgba.rgb, desp, saturate(despill_strength));

	 rgba.a *= mask;
	 rgba.rgb *= rgba.a;
	 return rgba;
}

// Static background removal: alpha comes from the distance to the captured
// plate instead of the distance to a key colour, so no despill is applied.
float4 PSPlateKey(VertData v_in) : TARGET
{
	float4 rgba = image.Sample(textureSampler, v_in.uv);
	rgba.rgb *= (rgba.a > 0.) ? (1. / rgba.a) : 0.;

	 float dist = FilteredPlateDiff(v_in.uv);
	 float mask = saturate((dist - plate_tolerance) / max(plate_softness, 1e-4));

	 rgba.a *= mask;
	 rgba.rgb *= rgba.a;
	 return rgba;
}

// Pass-through: captures the frame into the plate texture, and shows the
// untouched source while plate mode is on but no plate has been captured yet.
float4 PSCopy(VertData v_in) : TARGET
{
	return image.Sample(textureSampler, v_in.uv);
}

// 1 = the colour is the key colour (green screen), 0 = clearly not.
float Greenness(float3 srgb, float3 keynrm)
{
	float d = KeyDist(srgb, keynrm);
	return 1.0 - smoothstep(similarity, similarity + max(smoothness, 1e-4), d);
}

// Average greenness of eight samples around the pixel at the given radius.
float GreenAround(float2 uv, float3 keynrm, float r)
{
	float g = Greenness(image.Sample(textureSampler, uv + float2(r, 0.0)).rgb, keynrm);
	g += Greenness(image.Sample(textureSampler, uv + float2(-r, 0.0)).rgb, keynrm);
	g += Greenness(image.Sample(textureSampler, uv + float2(0.0, r)).rgb, keynrm);
	g += Greenness(image.Sample(textureSampler, uv + float2(0.0, -r)).rgb, keynrm);
	g += Greenness(image.Sample(textureSampler, uv + float2(r, r) * 0.7).rgb, keynrm);
	g += Greenness(image.Sample(textureSampler, uv + float2(-r, r) * 0.7).rgb, keynrm);
	g += Greenness(image.Sample(textureSampler, uv + float2(r, -r) * 0.7).rgb, keynrm);
	g += Greenness(image.Sample(textureSampler, uv + float2(-r, -r) * 0.7).rgb, keynrm);
	return g / 8.0;
}

// Is this pixel standing in front of the green screen? The background model
// cannot answer that for a subject who was already in frame when the filter was
// switched on - the model then holds the subject, not the screen. Evidence
// around the pixel can: inside the screen most samples are green, in the room
// none are. Two radii so that a subject wider than half the frame is still
// recognised, and the room (which is not surrounded by green) is not.
float ScreenPrior(float2 uv, float3 keynrm)
{
	float near_avg = GreenAround(uv, keynrm, 0.08);
	float far_avg = GreenAround(uv, keynrm, 0.22);
	return max(smoothstep(0.25, 0.60, near_avg), smoothstep(0.20, 0.55, far_avg));
}

// --- Moving subject mode -------------------------------------------------
// Three passes per frame: seed (below), update the background/age state, and
// the key itself. The state target is ping-ponged by the C side.

float StateDiffAt(float2 uv)
{
	return PlateDiff(frame_image.Sample(textureSampler, uv).rgb,
	                 state_image.Sample(textureSampler, uv).rgb);
}

// Blurred motion distance: a single noisy pixel must not count as movement.
float FilteredStateDiff(float2 uv)
{
	 float2 h = uv_pixel_interval;
	 float d = StateDiffAt(uv - float2(h.x * 2.0, h.y));
	 d += StateDiffAt(uv + float2(h.x * 2.0, h.y));
	 d += StateDiffAt(uv + float2(h.x, -h.y * 2.0));
	 d += StateDiffAt(uv + float2(-h.x, h.y * 2.0));
	 d *= 2.0;
	 d += StateDiffAt(uv);
	 d /= 9.0;
	 return lerp(StateDiffAt(uv), d, saturate(denoise));
}

// Seeds the background model from the current frame.
float4 PSSeedState(VertData v_in) : TARGET
{
	return float4(frame_image.Sample(textureSampler, v_in.uv).rgb, 1.0);
}

// One step of the background model: a pixel that differs from the background is
// moving (age 0, background frozen so the subject is never learned); a pixel
// that matches it gets older, and once it has been still for a moment the
// background learns it, which is what removes static non-green clutter - and
// what lets a ghost disappear after the subject walks away.
float4 PSUpdateState(VertData v_in) : TARGET
{
	float2 uv = v_in.uv;
	float3 cur = frame_image.Sample(textureSampler, uv).rgb;
	float4 st = state_image.Sample(textureSampler, uv);

	// The background drifts towards the frame at a rate the C side derives from
	// the hold time (1 - exp(-dt/hold), fast while warming up). Static clutter is
	// absorbed and disappears; a moving subject is always ahead of the drift, and
	// the area it leaves behind is re-learned quickly.
	float learn = saturate(motion_learn);
	float3 bg = lerp(st.rgb, cur, learn);

	return float4(bg, 1.0);
}

// The key: keep what is moving (age younger than the hold time) and is not the
// green screen. The chroma term also removes the moving shadow on the screen,
// the motion term removes everything static that is not green.
float4 PSMovingKey(VertData v_in) : TARGET
{
	float2 uv = v_in.uv;
	float4 rgba = image.Sample(textureSampler, uv);
	rgba.rgb *= (rgba.a > 0.) ? (1. / rgba.a) : 0.;

	float3 keynrm = normRGB(toLinear(key_color.rgb));

	// (a) keep what differs from the learned background right now
	float diff = FilteredStateDiff(uv);
	float motion_keep =
		smoothstep(motion_sensitivity, max(motion_sensitivity * 3.0, 0.02), diff);

	// (b) keep anything that stands in front of the green screen, moving or
	// not: a person who sits still in front of the screen is not background and
	// must stay visible no matter how long they hold still. "In front of the
	// screen" is both what the model learned (green there) and the local
	// evidence around the pixel, which also covers a subject who was already in
	// frame when the filter was switched on.
	float3 bg = state_image.Sample(textureSampler, uv).rgb;
	float model_screen = Greenness(bg, keynrm);
	float in_screen = max(model_screen, ScreenPrior(uv, keynrm));

	float keep = max(motion_keep, in_screen);

	// (c) never keep the screen itself
	float gdist = FilteredKeyDist(rgba.rgb, uv, keynrm);
	float green_keep = pow(saturate((gdist - similarity) / max(smoothness, 1e-4)), 1.5);

	float mask = keep * green_keep;

	float3 desp = Despill(rgba.rgb);
	rgba.rgb = lerp(rgba.rgb, desp, saturate(despill_strength));

	rgba.a *= mask;
	rgba.rgb *= rgba.a;
	return rgba;
}

technique Draw
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSChromaKeyPro(v_in);
	}
}

technique DrawPlate
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSPlateKey(v_in);
	}
}

technique DrawMotion
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSMovingKey(v_in);
	}
}

technique SeedState
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSSeedState(v_in);
	}
}

technique UpdateState
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSUpdateState(v_in);
	}
}

technique Copy
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSCopy(v_in);
	}
}
